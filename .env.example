# Konfigurasi Server PostgreSQL
# Salin file ini ke .env untuk pengembangan lokal, JANGAN commit .env ke repository.

# Alias PG_* dan fallback generik DB_* juga tetap didukung
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=migrator_user
POSTGRES_PASSWORD=change_me
# Gunakan 'require' atau 'verify-full' pada environment staging/production jika TLS aktif
POSTGRES_SSLMODE=disable

# Contoh override nama database per environment (jika database_env disetel di databases.yaml)
# POSTGRES_DB_NAME=db_name_staging

# Contoh override DSN terpisah (jika dsn_env disetel di databases.yaml untuk DB di server berbeda)
# POSTGRES_DSN_DB_NAME=postgres://migrator_user:secret@analytics-pg.internal:5432/analytics_db?sslmode=require
